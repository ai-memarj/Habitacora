__pycache__/
*.pyc
.venv/
venv/
data/*.db
.env
.DS_Store

# El frontend (Next.js) tiene su propio .gitignore en /frontend que ya
# cubre node_modules/.next/etc. Esta línea es un cinturón de seguridad
# por si alguna vez se ejecuta npm install desde la raíz por error.
node_modules/

# Salida del MCP de Playwright (capturas, snapshots y logs de consola de
# cada sesión de verificación en el navegador). Son artefactos de una
# sesión concreta, no del proyecto.
.playwright-mcp/
